{
  "name": "dsh-agent-control-plugin",
  "version": "0.1.9",
  "description": "Out-of-tree DeepSeek Harness Agent Bridge and Hermes Kanban control workspace",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "python",
    "fixtures",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preview:mock": "pnpm build && vite --config preview.config.ts --open /fixtures/session-preview.html",
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-approval": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-user-questions": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.3-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.3-alpha.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-approval": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-user-questions": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "26.1.0",
    "oxlint": "^1.13.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.15.4",
    "typescript": "~5.9.2",
    "vite": "6.4.1",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
