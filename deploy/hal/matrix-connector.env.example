# /etc/agent-bridge/matrix-connector.env (0600). Copy, fill in from approved credentials.
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@megumi:example.com
# One of the two. With a password the connector logs in once and keeps the device token in its state file.
MATRIX_ACCESS_TOKEN=
MATRIX_PASSWORD=
# Only these senders are acted on (comma-separated).
MATRIX_ALLOWED_USERS=@me:example.com
# Agent Bridge public API; the token is an AGENT_TOKENS entry (e.g. matrix:<token>:agent).
AGENT_BRIDGE_URL=http://127.0.0.1:8787
AGENT_BRIDGE_TOKEN=
MATRIX_CONNECTOR_STATE=/var/lib/agent-bridge/matrix-connector.json
