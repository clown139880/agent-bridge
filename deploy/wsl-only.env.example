# WSL-only Agent Bridge profile. Copy the required values into .env.bridge.
# Keep Windows Desktop sessions on a separate Windows-native Bridge.
CONTROL_WS_URL=ws://control-plane.example:8787/bridge
BRIDGE_TOKEN=replace-me
MACHINE_ID=dev-wsl
MACHINE_NAME=dev-wsl
BRIDGE_ALLOWED_ROOTS=/home/<linux-user>/Workspace

# Agent backends this bridge runs. Comma-separated: "codex", "claude", or "codex,claude".
BRIDGE_PROVIDERS=codex
CODEX_COMMAND=/home/<linux-user>/.local/share/pnpm/bin/codex
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_APP_SERVER_MANAGED=true
# Claude Code provider (used when BRIDGE_PROVIDERS includes "claude").
CLAUDE_COMMAND=/home/<linux-user>/.local/share/pnpm/bin/claude
# CLAUDE_HOME=/home/<linux-user>/.claude
CLAUDE_SCAN_EXISTING=false

# Intentionally unset for WSL-only operation:
# CODEX_DESKTOP_HOME=

# Self-update from immutable compiled releases (mirrors the HAL model). Updates
# fast-forward a shared source checkout, build compiled artifacts into a pruned
# releases directory that shares one pnpm store, then atomically switch the
# `current` symlink the service runs from. Replaces the old scheme that cloned a
# full source tree per release.
BRIDGE_AUTO_UPDATE=true
BRIDGE_UPDATE_SOURCE=https://github.com/clown139880/agent-bridge.git
BRIDGE_UPDATE_REF=main
# Shared git checkout updates build from (also the home of this .env.bridge).
BRIDGE_UPDATE_SOURCE_CHECKOUT=/home/<linux-user>/agent-bridge
BRIDGE_UPDATE_INSTALL_ROOT=/home/<linux-user>/.local/share/agent-bridge
BRIDGE_UPDATE_STORE_DIR=/home/<linux-user>/.local/share/agent-bridge/pnpm-store
BRIDGE_UPDATE_RELEASE_RETENTION=2
BRIDGE_UPDATE_CURRENT_LINK=/home/<linux-user>/.local/share/agent-bridge/current
BRIDGE_UPDATE_STATE_PATH=/home/<linux-user>/.local/share/agent-bridge/update-state.json
BRIDGE_UPDATE_RESTART_EXECUTABLE=/usr/bin/systemctl
BRIDGE_UPDATE_RESTART_ARGS=["--user","--no-block","restart","agent-bridge-wsl.service"]

# Bootstrap once before first start so `current` exists (the unit runs from it):
#   AGENT_BRIDGE_ENV_FILE=/home/<linux-user>/agent-bridge/.env.bridge \
#     AGENT_BRIDGE_REPO=/home/<linux-user>/agent-bridge \
#     AGENT_BRIDGE_INSTALL_ROOT=/home/<linux-user>/.local/share/agent-bridge \
#     AGENT_BRIDGE_SERVICE=agent-bridge-wsl.service AGENT_BRIDGE_MACHINE_ID=dev-wsl \
#     deploy/hal/deploy-bridge.sh
