# Copy to %LOCALAPPDATA%\agent-bridge\bridge.env and set BRIDGE_TOKEN locally.
CONTROL_WS_URL=ws://192.168.5.44:8787/bridge
BRIDGE_TOKEN=<set-locally>
MACHINE_ID=dev-windows
MACHINE_NAME=dev-windows
BRIDGE_ALLOWED_ROOTS=C:\Users\clown\Workspace
CODEX_COMMAND=C:\Users\clown\AppData\Local\OpenAI\Codex\bin\<version>\codex.exe
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_APP_SERVER_MANAGED=true
CODEX_DESKTOP_HOME=C:\Users\clown\.codex
CODEX_DESKTOP_SCAN_INTERVAL_MS=3000
CODEX_DESKTOP_REPLAY_EXISTING=false
BRIDGE_AUTO_UPDATE=false
BRIDGE_UPDATE_INSTALL_ROOT=%LOCALAPPDATA%\agent-bridge
BRIDGE_ACTION_CACHE_PATH=%LOCALAPPDATA%\agent-bridge\action-cache.json
