# HAL Agent Bridge environment. Install as /etc/agent-bridge/bridge.env.
CONTROL_WS_URL=ws://127.0.0.1:8787/bridge
BRIDGE_TOKEN=replace-me
BRIDGE_ARCHIVE_OUTBOX_PATH=/var/lib/agent-bridge/hal-conversation-outbox.json
BRIDGE_ARCHIVE_OUTBOX_LIMIT=10000
# Point to the installed shared-skill manifest; this lets Bridge report version/hash status.
# BRIDGE_SHARED_SKILLS_MANIFEST=/root/.codex/skills/shared-skills/manifest.json
# BRIDGE_CONVERSATION_MCP_CONFIGURED=true
MACHINE_ID=hal
MACHINE_NAME=hal
BRIDGE_ALLOWED_ROOTS=/root/agent-bridge
CODEX_COMMAND=/usr/local/bin/codex
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_APP_SERVER_MANAGED=true

# HAL is deployed with deploy/hal/deploy.sh, never by Bridge self-update, and runs
# from the /root/agent-bridge checkout. Keep runtime state next to the outbox.
BRIDGE_AUTO_UPDATE=false
BRIDGE_ACTION_CACHE_PATH=/var/lib/agent-bridge/hal-action-cache.json

# Manual HAL deployment behavior. Notify after 2 minutes; interrupt and force
# activation after 4 minutes if sessions are still active.
AGENT_BRIDGE_DEPLOY_NOTIFY_AFTER=120
AGENT_BRIDGE_DEPLOY_FORCE_AFTER=240
AGENT_BRIDGE_DEPLOY_POLL_INTERVAL=5
AGENT_BRIDGE_CONTROL_API_URL=http://127.0.0.1:8787
AGENT_BRIDGE_CONTROL_API_TOKEN=replace-with-control-api-write-token
# Optional executable receiving event details through AGENT_BRIDGE_DEPLOY_* env vars.
# AGENT_BRIDGE_DEPLOY_NOTIFY_COMMAND=/usr/local/bin/hermes-deploy-notify
