# HAL Agent Bridge environment. Install as /etc/agent-bridge/bridge.env.
CONTROL_WS_URL=ws://127.0.0.1:8787/bridge
BRIDGE_TOKEN=replace-me
MACHINE_ID=hal
MACHINE_NAME=hal
BRIDGE_ALLOWED_ROOTS=/root/agent-bridge
CODEX_COMMAND=/usr/local/bin/codex
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_APP_SERVER_MANAGED=true

# Updates are built from this checkout, then launched from immutable releases.
BRIDGE_AUTO_UPDATE=true
BRIDGE_UPDATE_SOURCE=https://github.com/clown139880/agent-bridge.git
BRIDGE_UPDATE_REF=main
BRIDGE_UPDATE_SOURCE_CHECKOUT=/root/agent-bridge
BRIDGE_UPDATE_INSTALL_ROOT=/opt/agent-bridge
BRIDGE_UPDATE_STORE_DIR=/opt/agent-bridge/pnpm-store
BRIDGE_UPDATE_RELEASE_RETENTION=2
BRIDGE_UPDATE_CURRENT_LINK=/opt/agent-bridge/current
BRIDGE_UPDATE_STATE_PATH=/opt/agent-bridge/update-state.json
BRIDGE_UPDATE_RESTART_EXECUTABLE=/usr/bin/systemctl
BRIDGE_UPDATE_RESTART_ARGS=["--no-block","restart","agent-bridge-hal.service"]
