# Rule-only Claude approval profile for a Bridge env file (dev-wsl `.env.bridge`).
# Rationale, deny/ask choices and rollout: docs/approval-permissions.zh.md §6.
# Merge into the target env file: replace CLAUDE_PERMISSION_ALLOW (it drops
# Bash(git:*); keep any extra non-Bash entries that file already has) and add
# CLAUDE_PERMISSION_DENY. Keep CLAUDE_PERMISSION_MODE=acceptEdits and
# CLAUDE_AUTO_APPROVE=readonly. Each value must stay on one line, and rules must
# not contain commas, `#`, `$` or backslashes (systemd EnvironmentFile + dotenv,
# and the Bridge joins rules with commas for --allowedTools).
CLAUDE_PERMISSION_ALLOW=["Read(**)","Glob(**)","Grep","TodoWrite","mcp__conversation-memory","Bash(git status:*)","Bash(git log:*)","Bash(git diff:*)","Bash(git show:*)","Bash(git branch)","Bash(git branch --show-current)","Bash(git branch --list:*)","Bash(git branch -a:*)","Bash(git branch -r:*)","Bash(git branch -v:*)","Bash(git branch -vv:*)","Bash(git rev-parse:*)","Bash(git ls-files:*)","Bash(git blame:*)","Bash(git grep:*)","Bash(git describe:*)","Bash(git remote -v)","Bash(git fetch:*)","Bash(git add:*)","Bash(git commit:*)","Bash(git pull --ff-only:*)","Bash(git worktree list:*)","Bash(git stash list:*)","Bash(git config --get:*)","Bash(git -C * status*)","Bash(git -C * log*)","Bash(git -C * diff*)","Bash(git -C * show*)","Bash(git -C * rev-parse*)","Bash(ps:*)","Bash(pgrep:*)","Bash(stat:*)","Bash(find:*)","Bash(ss:*)","Bash(df:*)","Bash(du:*)","Bash(free:*)","Bash(uptime)","Bash(which:*)","Bash(jq:*)","Bash(journalctl:*)","Bash(systemctl status:*)","Bash(systemctl show:*)","Bash(systemctl cat:*)","Bash(systemctl list-units:*)","Bash(systemctl list-timers:*)","Bash(systemctl is-active:*)","Bash(systemctl is-enabled:*)","Bash(systemctl is-failed:*)","Bash(systemctl --user status:*)","Bash(systemctl --user show:*)","Bash(systemctl --user cat:*)","Bash(systemctl --user list-units:*)","Bash(systemctl --user list-timers:*)","Bash(systemctl --user is-active:*)","Bash(systemctl --user is-enabled:*)","Bash(systemctl --user is-failed:*)","Bash(python -m unittest:*)","Bash(python3 -m unittest:*)","Bash(PYTHONPATH=* python -m unittest*)","Bash(PYTHONPATH=* python3 -m unittest*)","Bash(python -m pytest:*)","Bash(python3 -m pytest:*)","Bash(pytest:*)","Bash(pnpm test:*)","Bash(pnpm typecheck:*)","Bash(pnpm exec tsc --noEmit:*)","Bash(powercfg.exe /q:*)","Bash(powercfg.exe /query:*)","Bash(powercfg.exe /requests)","Bash(powercfg.exe /a)","Bash(powercfg.exe /getactivescheme)","Bash(powercfg.exe /l)"]
CLAUDE_PERMISSION_DENY=["Bash(git reset --hard:*)","Bash(git clean -*f*)","Bash(git clean --force*)","Bash(git push --force:*)","Bash(git push -f:*)","Bash(git push --force-with-lease:*)","Bash(git push * --force*)","Bash(git push * -f*)","Bash(git push * +*)","Bash(find * -delete*)","Bash(find * -exec*)","Bash(find * -execdir*)","Bash(find * -ok*)","Bash(journalctl --vacuum*)","Bash(journalctl --rotate*)","Bash(journalctl --flush*)","Bash(journalctl * --vacuum*)","Bash(journalctl * --rotate*)","Bash(journalctl * --flush*)","Bash(systemctl --user restart agent-bridge*)","Bash(systemctl --user stop agent-bridge*)","Bash(systemctl restart agent-bridge*)","Bash(systemctl stop agent-bridge*)","Bash(systemctl restart agent-control-plane*)","Bash(systemctl stop agent-control-plane*)","Bash(docker rm *)","Bash(docker rmi *)","Bash(docker stop *)","Bash(docker restart *)","Bash(docker kill *)","Bash(docker run *)","Bash(docker exec *)","Bash(docker compose down*)","Bash(docker system prune*)","Bash(docker volume rm *)","Bash(docker volume prune*)","Bash(docker image prune*)"]
