MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@agent-control:example.com
MATRIX_PASSWORD=change-me
# Existing room ID; omit it once to let the bot create a private room.
# MATRIX_ROOM_ID=!room:example.com
MATRIX_ROOM_NAME=Agent Control
# Strongly recommended: only this Matrix user may control agents.
MATRIX_ALLOWED_USER_ID=@you:example.com

CONTROL_HOST=0.0.0.0
CONTROL_PORT=8787
CONTROL_WS_URL=ws://127.0.0.1:8787/bridge
DATABASE_PATH=./data/control-plane.sqlite
BRIDGE_TOKEN=replace-with-a-long-random-token

MACHINE_ID=bridge-01
MACHINE_NAME=development-machine
BRIDGE_ALLOWED_ROOTS=/root
CODEX_COMMAND=codex
CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
CODEX_APP_SERVER_MANAGED=true
# Optional: monitor sessions created by the official Codex Desktop app.
# On WSL this is typically /mnt/c/Users/<windows-user>/.codex.
# The managed app-server must be able to resume threads from the same CODEX_HOME.
# Enabling this also gives the managed app-server the same CODEX_HOME.
# CODEX_DESKTOP_HOME=/mnt/c/Users/<windows-user>/.codex
CODEX_DESKTOP_SCAN_INTERVAL_MS=3000
# Set true only when intentionally importing already-completed turns on first startup.
CODEX_DESKTOP_REPLAY_EXISTING=false
